<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sample.Avalonia.ViewModels"
             xmlns:hutu="using:Hutu.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sample.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Grid.Column="0" x:Name="BackButton" Content="←" ToolTip.Tip="Backward" Click="Back_Click" IsEnabled="False" />
            <Button Grid.Column="1" x:Name="ForwardButton" Content="→" ToolTip.Tip="Forward" Click="Forward_Click" IsEnabled="False" />
            <Button Grid.Column="2" x:Name="RefreshButton" Content="⟳" ToolTip.Tip="Refresh" Click="Refresh_Click" IsEnabled="False" />
            <TextBox Grid.Column="3" x:Name="AddressBar" PlaceholderText="Enter URL..." KeyDown="AddressBar_KeyDown" />
            <ToggleButton Grid.Column="4" x:Name="OverlayButton" Content="FPS" IsChecked="False"
                          ToolTip.Tip="Rendering Diagnostics Overlay (FPS / Render Time)" Click="Overlay_Click" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="Zoom: Ctrl + wheel, Ctrl + Plus, Ctrl + Minus, Ctrl + 0">
                <Button Content="−" Width="28" Click="ZoomOut_Click" />
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="4,0" MinWidth="44" TextAlignment="Center" />
                <Button Content="+" Width="28" Click="ZoomIn_Click" />
                <Button Content="⤢" Width="28" Margin="4,0,0,0" Click="ZoomReset_Click" ToolTip.Tip="Reset zoom (Ctrl + 0)" />
                <Button x:Name="FitButton" Content="Fit" Width="32" Margin="4,0,0,0" Click="Fit_Click"
                        IsEnabled="False" ToolTip.Tip="Fit the page to the window" />
            </StackPanel>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <ToggleButton x:Name="PagedButton" Content="Pages"
                              ToolTip.Tip="Show the document as the pages it prints on" Click="Paged_Click" />
                <Button x:Name="PreviousPageButton" Content="&#x2039;" ToolTip.Tip="Previous page"
                        Click="PreviousPage_Click" IsEnabled="False" />
                <TextBlock x:Name="PageLabel" Text="&#x2014;" VerticalAlignment="Center"
                           MinWidth="48" TextAlignment="Center" />
                <Button x:Name="NextPageButton" Content="&#x203A;" ToolTip.Tip="Next page"
                        Click="NextPage_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <hutu:HutuView Grid.Row="1" x:Name="MyHutuView">
            <ScrollViewer.Styles>
                <Style Selector="ScrollBar">
                    <Setter Property="ShowDelay" Value="0" />
                    <Setter Property="HideDelay" Value="0" />
                    <Setter Property="AllowAutoHide" Value="False" />
                </Style>
            </ScrollViewer.Styles>
        </hutu:HutuView>
    </Grid>
</ContentPage>
