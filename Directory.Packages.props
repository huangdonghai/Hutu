    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.500-preview.1.26471.14" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0-preview.1.26471.14" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.154.0-preview.1.26454.9" />
