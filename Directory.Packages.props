<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <PackageVersion Include="AngleSharp.Css" Version="1.1.2" />
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Skia/HarfBuzz must match what Avalonia.Skia 12.1.3 brings in, or the native binding
         resolves to a different major and the app fails to load it. -->
    <PackageVersion Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
    <!-- Svg.Skia 4.9.1 requires SkiaSharp >= 3.119.2 and HarfBuzzSharp >= 8.3.1.3, which is why it is
         pinned here: 5.x requires SkiaSharp >= 4.148.0 and would pull the whole stack off the version
         Avalonia.Skia 12.1.3 needs. -->
    <PackageVersion Include="Svg.Skia" Version="4.9.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- The reference collector drives the Edge that is already installed (channel: msedge), so this
         package brings the driver but never a browser download. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.60.0" />
    <!-- NUnit 4 is a floor set by Avalonia.Headless.NUnit, which needs >= 4.5.1. The tests only use
         the constraint model (Assert.That) and no classic asserts, so the major version is not a
         breaking change for them. -->
    <PackageVersion Include="NUnit" Version="4.5.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>
</Project>