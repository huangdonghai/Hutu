<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The vendored AngleSharp sources are referenced as projects rather than packages so that the
    style engine can be patched in place: the published AngleSharp.Css (1.1.2, and the newest
    1.1.3-beta.330) both still throw while computing a layered background, and Hutu depends on
    that being fixed. See deps/Directory.Packages.props for the CPM opt-out this requires.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\deps\AngleSharp.Css\src\AngleSharp.Css\AngleSharp.Css.csproj" />
    <ProjectReference Include="..\..\deps\AngleSharp\src\AngleSharp\AngleSharp.Core.csproj" />
  </ItemGroup>

  <!--
    Everything the engine keeps to itself is internal now, so the tests that reach into style
    computation, the box tree and the layout algorithm are granted the internals of this assembly.
    They are separate assemblies rather than part of it, so the grant has to be said out loud.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hutu.Tests" />
    <InternalsVisibleTo Include="Hutu.Avalonia.Tests" />
  </ItemGroup>

</Project>
