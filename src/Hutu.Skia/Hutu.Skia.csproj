<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hutu\Hutu.csproj" />
  </ItemGroup>

  <!-- The font resolver, the shaper and the decomposition are the measurer's own machinery; the tests
       that check a glyph actually landed in the right font are another assembly, so the internals have
       to be opened to them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hutu.Tests" />
  </ItemGroup>

</Project>
